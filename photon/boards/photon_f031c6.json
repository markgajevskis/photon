{
  "build": {
    "arduino": {
      "variant_h": "variant_generic.h"
    },
    "core": "stm32",
    "cpu": "cortex-m0",
    "extra_flags": "-DSTM32F0 -DSTM32F031x6 -DARDUINO_GENERIC_F031C6TX",
    "f_cpu": "48000000L",
    "mcu": "stm32f031c6t6",
    "product_line": "STM32F031x6",
    "variant": "STM32F0xx/F031C(4-6)T"
  },
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32F031C6",
    "openocd_extra_args": [
      "-c",
      "reset_config none"
    ],
    "openocd_target": "stm32f0x",
    "svd_path": "STM32F031x.svd"
  },
  "frameworks": [
    "arduino",
    "cmsis",
    "stm32cube",
    "libopencm3"
  ],
  "name": "Photon STM32F031C6",
  "upload": {
    "maximum_ram_size": 4096,
    "maximum_size": 32768,
    "protocol": "stlink",
    "protocols": [
      "jlink",
      "cmsis-dap",
      "stlink",
      "blackmagic",
      "serial"
    ]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32f031c6.html",
  "vendor": "Photon"
}
